/.phpunit.cache
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
/storage/app/private/*
!/storage/app/private/.gitkeep
/storage/app/public/*
!/storage/app/public/.gitkeep
# Imagens de marca (logo, brasao, igreja, galeria padrao) sao assets versionados da aplicacao,
# nao upload de usuario -- nao podem depender so do disco local (ver Setting::DEFAULTS/MediaItemSeeder).
!/storage/app/public/site/
!/storage/app/public/site/**
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitkeep
/storage/framework/sessions/*
!/storage/framework/sessions/.gitkeep
/storage/framework/testing/*
!/storage/framework/testing/.gitkeep
/storage/framework/views/*
!/storage/framework/views/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep
/vendor
.env
.env.backup
.env.production
.phpactor.json
Homestead.json
Homestead.yaml
auth.json
npm-debug.log
yarn-error.log
/.fleet
/.idea
/.nova
/.vscode
/.zed
