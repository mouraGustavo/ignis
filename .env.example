APP_NAME=Ignis
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ignis
DB_USERNAME=postgres
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database

QUEUE_CONNECTION=database

# Em Docker (docker-compose.yml) o serviço "mailpit" captura os e-mails em
# http://localhost:8025 — fora do Docker, MAIL_MAILER=log escreve no storage/logs.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@ignis.local"
MAIL_FROM_NAME="${APP_NAME}"

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

FILESYSTEM_DISK=local

# Usados pelo AdminUserSeeder (database/seeders/AdminUserSeeder.php).
ADMIN_SEED_EMAIL=admin@ignis.local
ADMIN_SEED_PASSWORD=troque-esta-senha

VITE_APP_NAME="${APP_NAME}"

# Efí Bank — API Cobranças (cartão de crédito)
EFI_SANDBOX=true
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_CERTIFICATE_PATH=storage/app/private/efi/certificate.p12
EFI_CERTIFICATE_PASSWORD=
EFI_PAYEE_CODE=
EFI_NOTIFICATION_URL=
EFI_TIMEOUT=30
EFI_CACHE=true
EFI_DEBUG=false
